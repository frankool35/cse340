<%- include("partials/header", { title: title }) %>

    <main>

        <h2>
            <%= project.title %>
        </h2>

        <p>
            <strong>Description:</strong><br>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong><br>
            <%= project.date.toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong><br>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong><br>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (isLoggedIn) { %>
        
            <hr>
        
            <% if (!volunteering) { %>
        
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
        
                    <button type="submit">
                        Volunteer for this Project
                    </button>
        
                </form>
        
                <% } else { %>
        
                    <p>
                        <strong>
                            ✓ You are volunteering for this project.
                        </strong>
                    </p>
        
                    <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
        
                        <button type="submit">
                            Remove Volunteer
                        </button>
        
                    </form>
        
                    <% } %>
        
                        <% } %>


        <p>
            <strong>Categories:</strong><br>

            <% if (categories.length> 0) { %>

                <% categories.forEach(category=> { %>

                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a><br>

                    <% }) %>

                        <% } else { %>

                            No categories assigned.

                            <% } %>

        </p>

        <% if (user && user.role_name==="admin" ) { %>
        
            <p>
                <a href="/assign-categories/<%= project.project_id %>">
                    Assign Categories
                </a>
            </p>
        
            <% } %>

        <p>
            <% if (user && user.role_name==="admin" ) { %>

            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
            <% } %>

        </p>

        <p>
            <a href="/projects">
                ← Back to Projects
            </a>
        </p>

    </main>

    <%- include("partials/footer") %>